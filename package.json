{
  "name": "plaud-notes-to-notion",
  "version": "1.2.4",
  "description": "macOS LaunchAgent that copies finished Plaud recordings into a Notion database as Summary and Transcript rows, with SSN and payment-card redaction, LLM participant labels, and Summary-to-Transcript title/participant sync.",
  "type": "module",
  "main": "dist/cli.js",
  "bin": {
    "plaud-notes-to-notion": "./bin/plaud-notes-to-notion.js"
  },
  "author": "sfls1397",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sfls1397/Plaud-Notes-to-Notion.git"
  },
  "homepage": "https://github.com/sfls1397/Plaud-Notes-to-Notion#readme",
  "keywords": [
    "plaud",
    "notion",
    "launchagent",
    "transcripts"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "files": [
    "dist/",
    "bin/",
    "examples/",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "os": [
    "darwin",
    "linux"
  ],
  "scripts": {
    "build": "tsc",
    "prepare": "tsc",
    "start": "node dist/cli.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "audit": "npm audit --omit=dev",
    "scan:package": "node scripts/scan-package.js",
    "prepublishOnly": "npm run security:check && npm run build && npm run scan:package",
    "security:check": "python3 .security/scan.py all"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}
