{
  "name": "plaud-notes-to-notion",
  "version": "1.1.0",
  "description": "Mac Mini LaunchAgent: new Plaud recordings → Plaud Notes Notion database (Summary + Transcript rows), plus Summary→Transcript title/participant sync. Replaces the Zapier Plaud → Notion Zaps.",
  "type": "module",
  "main": "dist/cli.js",
  "bin": {
    "plaud-notes-to-notion": "./bin/plaud-notes-to-notion.js"
  },
  "author": "Peter Coates",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sfls1397/Plaud-Notes-to-Notion.git"
  },
  "homepage": "https://github.com/sfls1397/Plaud-Notes-to-Notion#readme",
  "keywords": [
    "plaud",
    "notion",
    "launchagent",
    "transcripts"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "files": [
    "dist/",
    "bin/",
    "examples/",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "os": [
    "darwin",
    "linux"
  ],
  "scripts": {
    "build": "tsc",
    "prepare": "tsc",
    "start": "node dist/cli.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "audit": "npm audit --omit=dev"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}
